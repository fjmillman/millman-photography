{
  "name": "millman-photography",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "build": "run-s \"build:*\"",
    "build:prisma": "npm run prisma:generate && npm run prisma:push",
    "build:react": "react-router build",
    "dev": "run-p \"dev:*\"",
    "dev:prisma": "npm run prisma:generate",
    "dev:s3": "npx sls offline",
    "dev:react": "react-router dev",
    "start": "run-p \"start:*\"",
    "start:prisma": "npm run prisma:generate",
    "start:s3": "npx sls offline",
    "start:react": "react-router-serve ./build/server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:push": "prisma db push",
    "migration:generate": "prisma migrate dev --name init",
    "migration:apply": "turso db shell turso-prisma-db < ./prisma/migrations/20230922132717_init/migration.sql",
    "typecheck": "react-router typegen && tsc",
    "lint": "react-router typegen && eslint 'app/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write 'app/**/*.{js,jsx,ts,tsx}'",
    "format:fix": "npm run format -- --write"
  },
  "prisma": {
    "seed": "vite-node prisma/seed.ts"
  },
  "lint-staged": {
    "app/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.750.0",
    "@libsql/client": "^0.8.1",
    "@mdx-js/rollup": "^3.1.0",
    "@mjackson/form-data-parser": "^0.7.0",
    "@prisma/adapter-libsql": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@react-router/fs-routes": "^7.2.0",
    "@react-router/node": "^7.2.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cuid": "^3.0.0",
    "isbot": "^5.1.23",
    "mdx-bundler": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-mdx-import-media": "^1.2.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@react-router/dev": "^7.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vercel/node": "^5.1.8",
    "@vercel/react-router": "^1.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.2",
    "prisma": "^6.4.1",
    "serverless": "^4.6.4",
    "serverless-offline": "^14.4.0",
    "serverless-s3-local": "^0.8.5",
    "tailwindcss": "^4.0.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=23.7.0"
  },
  "overrides": {
    "serverless-s3-local": {
      "serverless": "$serverless"
    }
  }
}
